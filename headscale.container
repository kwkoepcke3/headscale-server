[Unit]
Description=Headscale Control Server
After=network-online.target traefik.service
Wants=network-online.target

[Container]
ContainerName=headscale
Image=ghcr.io/juanfont/headscale:stable
Exec=serve
Network=traefik.network
AutoUpdate=registry

Volume=%h/mayo-server/subserv/headscale/config/headscale:/etc/headscale:z
Volume=%h/mayo-server/subserv/headscale/runtime/headscale/data:/var/lib/headscale:z

Label=traefik.enable=true
Label=traefik.docker.network=traefik.network
Label=traefik.http.routers.headscale.rule=Host(`scale.meiyou.io`) && !PathPrefix(`/admin`)
Label=traefik.http.routers.headscale.entrypoints=websecure
Label=traefik.http.routers.headscale.tls.certresolver=websecure
Label=traefik.http.services.headscale.loadbalancer.server.port=8080

Label=traefik.http.routers.headscale.middlewares=cors
Label=traefik.http.middlewares.cors.headers.accesscontrolallowheaders=*
Label=traefik.http.middlewares.cors.headers.accesscontrolallowmethods=GET,POST,PUT
Label=traefik.http.middlewares.cors.headers.accesscontrolalloworiginlist=https://scale.meiyou.io
Label=traefik.http.middlewares.cors.headers.accesscontrolmaxage=100
Label=traefik.http.middlewares.cors.headers.addvaryheader=true

[Service]
Restart=always

[Install]
WantedBy=default.target
